---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  slug?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/jinri-todo/jinri_todo_cover.png',
  slug = ''
} = Astro.props;

const site = 'https://caisuqing666.github.io';
const baseUrl = slug ? `${site}/jinri-todo/${slug}/` : `${site}/jinri-todo/`;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={baseUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={baseUrl} />
    <meta property="og:site_name" content="今日todo百科" />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={`${site}${ogImage}`} />
    <style is:global>
      :root {
        --text: #1a1a1a;
        --muted: #666;
        --bg: #fff;
        --line: #eaeaea;
        --card: #f7f7f7;
        --max: 720px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text: #f2f2f2;
          --muted: #b7b7b7;
          --bg: #0f0f10;
          --line: #2a2a2a;
          --card: #161618;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", sans-serif;
        line-height: 1.7;
        color: var(--text);
        background: var(--bg);
      }
      a {
        color: inherit;
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
      }
      a:hover {
        opacity: 0.8;
      }
      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 48px 20px;
      }
      h1 {
        font-size: 1.8rem;
        line-height: 1.25;
        margin: 0 0 12px;
        border-bottom: 2px solid var(--text);
        padding-bottom: 12px;
      }
      h2 {
        font-size: 1.15rem;
        margin: 24px 0 10px;
      }
      p {
        margin: 0 0 14px;
      }
      ul {
        margin: 0 0 14px;
        padding-left: 20px;
      }
      li {
        margin: 0 0 8px;
      }
      .box {
        background: var(--card);
        border-left: 3px solid var(--text);
        padding: 16px 20px;
        margin: 28px 0;
        border-radius: 8px;
      }
      .final {
        font-size: 1.05rem;
        margin: 36px 0;
        text-align: center;
      }
      .back {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <h1>{title}</h1>
      </header>
      <main>
        <slot />
      </main>
      <footer style="margin-top: 46px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted);">
        <p>「今日todo」方法论 | 版本 1.0</p>
        <p>最后更新：2026年2月5日</p>
      </footer>
    </div>
  </body>
</html>
